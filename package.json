{
  "name": "delisha-marie",
  "version": "0.0.0",
  "scripts": {
    "ng": "ng",
    "start": "ng serve",
    "start:kitchen": "vercel dev projects/kitchen --listen 4201",
    "start:home": "vercel dev projects/home --listen 4200",
    "start:admin": "ng serve admin --port 4209",
    "build": "ng build",
    "watch": "ng build --watch --configuration development",
    "test": "npm run test:app && npm run test:api",
    "test:api": "ng run serverless:test-api --coverage && ng run admin:test-api --coverage && ng run @dm/backend-shared:test-api --coverage",
    "test:app": "ng test --coverage",
    "test:all": "npm run lint && npm run test:app && npm run test:api && npm run e2e",
    "e2e": "npm run e2e:kitchen && npm run e2e:admin",
    "e2e:admin": "ng run admin:cypress-run",
    "e2e:kitchen": "ng run kitchen:cypress-run",
    "serve:ssr:kitchen": "node dist/kitchen/server/server.mjs",
    "serve:ssr:admin": "node dist/admin/server/server.mjs",
    "lint": "ng lint",
    "cypress:open": "cypress open",
    "cypress:run": "cypress run",
    "docker:dev": "docker compose -f docker-compose.dev.yml up -d --build",
    "docker:shell": "docker exec -it delisha-marie-dev bash",
    "docker:down": "docker compose -f docker-compose.dev.yml down"
  },
  "private": true,
  "dependencies": {
    "@angular/aria": "^22.2.6",
    "@angular/cdk": "^22.2.6",
    "@angular/common": "^22.2.5",
    "@angular/compiler": "^22.2.5",
    "@angular/core": "^22.2.5",
    "@angular/forms": "^22.2.5",
    "@angular/material": "^22.2.6",
    "@angular/platform-browser": "^22.2.5",
    "@angular/platform-server": "^22.2.5",
    "@angular/router": "^22.2.5",
    "@angular/service-worker": "^22.2.5",
    "@angular/ssr": "^22.2.6",
    "@descope/angular-sdk": "^0.29.0",
    "@descope/node-sdk": "^2.21.0",
    "@imagekit/nodejs": "^7.14.0",
    "@sentry/browser": "^11.11.0",
    "@supabase/supabase-js": "^2.119.0",
    "@vercel/analytics": "^2.0.1",
    "@vercel/speed-insights": "^2.1.0",
    "botid": "^1.5.12",
    "change-case": "^5.4.4",
    "cookie-parser": "^1.4.7",
    "express": "^5.3.0",
    "multer": "^2.5.0",
    "ngx-pagination": "^6.0.3",
    "rxjs": "~7.8.0",
    "sharp": "^0.35.5",
    "tailwindcss": "^4.3.5",
    "tslib": "^2.9.1"
  },
  "devDependencies": {
    "@angular/build": "^22.2.6",
    "@angular/cli": "^22.2.6",
    "@angular/compiler-cli": "^22.2.5",
    "@cypress/schematic": "^6.0.0",
    "@eslint/js": "^10.0.1",
    "@mcp-b/webmcp-polyfill": "^6.0.3",
    "@tailwindcss/container-queries": "^0.1.1",
    "@tailwindcss/postcss": "^4.3.5",
    "@types/cookie-parser": "^1.4.10",
    "@types/dom-screen-wake-lock": "^1.0.3",
    "@types/express": "^5.0.1",
    "@types/multer": "^2.3.0",
    "@types/node": "^26.6.6",
    "@types/supertest": "^7.2.1",
    "@vercel/node": "^30.0.0",
    "@vitest/coverage-v8": "^4.1.12",
    "angular-eslint": "22.6.0",
    "cypress": "^16.2.1",
    "eslint": "^10.0.3",
    "eslint-config-prettier": "^10.1.8",
    "eslint-plugin-prettier": "^5.5.7",
    "jsdom": "^31.0.0",
    "ng-packagr": "^22.2.6",
    "postcss": "^8.5.3",
    "prettier": "^3.9.10",
    "supertest": "^7.3.2",
    "typescript": "~6.0.3",
    "typescript-eslint": "8.72.1",
    "vitest": "^4.1.12"
  },
  "allowScripts": {
    "@parcel/watcher@2.6.0": true,
    "cypress@16.2.1": true,
    "esbuild@0.27.0": true,
    "esbuild@0.27.2": true,
    "esbuild@0.28.2": true,
    "lmdb@3.5.6": true,
    "msgpackr-extract@3.0.4": true
  }
}
