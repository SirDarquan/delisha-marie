{
  "name": "delisha-marie",
  "version": "0.0.0",
  "scripts": {
    "ng": "ng",
    "start": "ng serve",
    "start:vercel": "npx vercel dev projects/delisha-marie -l 4200",
    "start:home": "npx vercel dev projects/delisha-home -l 4220",
    "build": "ng build",
    "build:home": "ng build delisha-home",
    "watch": "ng build --watch --configuration development",
    "test": "npm run test:app && npm run test:api",
    "test:api": "ng run serverless:test-api --coverage && ng run admin-delisha-marie:test-api --coverage && ng run @dm/backend-shared:test-api --coverage",
    "test:app": "ng test --coverage",
    "test:home": "ng test delisha-home --coverage",
    "test:all": "npm run lint && npm run test:app && npm run test:api && npm run e2e",
    "e2e": "npm run e2e:blog && npm run e2e:admin",
    "e2e:admin": "ng run admin-delisha-marie:cypress-run",
    "e2e:blog": "ng run delisha-marie:cypress-run",
    "serve:ssr:delisha-marie": "node dist/delisha-marie/server/server.mjs",
    "serve:ssr:admin-delisha-marie": "node dist/admin-delisha-marie/server/server.mjs",
    "lint": "ng lint",
    "cypress:open": "cypress open",
    "cypress:run": "cypress run"
  },
  "private": true,
  "dependencies": {
    "@angular/aria": "^22.2.2",
    "@angular/cdk": "^22.2.2",
    "@angular/common": "^22.2.1",
    "@angular/compiler": "^22.2.1",
    "@angular/core": "^22.2.1",
    "@angular/forms": "^22.2.1",
    "@angular/material": "^22.2.2",
    "@angular/platform-browser": "^22.2.1",
    "@angular/platform-server": "^22.2.1",
    "@angular/router": "^22.2.1",
    "@angular/service-worker": "^22.2.1",
    "@angular/ssr": "^22.2.2",
    "@descope/angular-sdk": "^0.28.15",
    "@descope/node-sdk": "^2.18.0",
    "@imagekit/nodejs": "^7.12.1",
    "@sentry/browser": "^11.6.0",
    "@supabase/supabase-js": "^2.117.3",
    "@vercel/analytics": "^2.0.1",
    "@vercel/speed-insights": "^2.0.0",
    "botid": "^1.5.11",
    "change-case": "^5.4.4",
    "cookie-parser": "^1.4.7",
    "express": "^5.3.0",
    "multer": "^2.4.0",
