    "@types/cookie-parser": "^1.4.10",
    "@types/dom-screen-wake-lock": "^1.0.3",
    "@types/express": "^5.0.1",
    "@types/multer": "^2.3.0",
    "@types/node": "^20.17.19",
    "@types/supertest": "^7.2.1",
