{
  "name": "delisha-marie",
  "version": "0.0.0",
  "scripts": {
    "ng": "ng",
    "start": "ng serve",
    "build": "ng build",
    "watch": "ng build --watch --configuration development",
    "test": "npm run test:app && npm run test:api",
    "test:api": "ng run delisha-marie:test-api --coverage && ng run admin-delisha-marie:test-api --coverage && ng run @dm/backend-shared:test-api --coverage",
    "test:app": "ng test --coverage",
    "test:all": "npm run test && npm run lint && npm run e2e",
    "e2e": "npm run e2e:blog && npm run e2e:admin",
    "e2e:admin": "ng run admin-delisha-marie:cypress-run",
    "e2e:blog": "ng run delisha-marie:cypress-run",
    "serve:ssr:delisha-marie": "node dist/delisha-marie/server/server.mjs",
    "serve:ssr:admin-delisha-marie": "node dist/admin-delisha-marie/server/server.mjs",
    "lint": "ng lint",
    "cypress:open": "cypress open",
    "cypress:run": "cypress run"
  },
  "private": true,
  "packageManager": "npm@11.10.1",
  "dependencies": {
    "@angular/aria": "^22.0.3",
    "@angular/cdk": "^22.0.3",
    "@angular/common": "^22.0.5",
    "@angular/compiler": "^22.0.5",
    "@angular/core": "^22.0.5",
    "@angular/forms": "^22.0.5",
    "@angular/material": "^22.0.3",
    "@angular/platform-browser": "^22.0.5",
    "@angular/platform-server": "^22.0.5",
    "@angular/router": "^22.0.5",
    "@angular/ssr": "^22.0.5",
    "@descope/angular-sdk": "^0.25.7",
    "@descope/node-sdk": "^2.6.0",
    "@supabase/supabase-js": "^2.107.0",
    "change-case": "^5.4.4",
    "cookie-parser": "^1.4.7",
    "cypress": "^15.18.0",
    "express": "^5.1.0",
    "express-rate-limit": "^8.5.2",
    "ngx-pagination": "^6.0.3",
    "rxjs": "~7.8.0",
    "tailwindcss": "^4.3.0",
    "tslib": "^2.3.0"
  },
  "devDependencies": {
    "@angular/build": "^22.0.5",
    "@angular/cli": "^22.0.5",
    "@angular/compiler-cli": "^22.0.5",
    "@cypress/schematic": "^5.0.0",
    "@eslint/js": "^10.0.1",
    "@tailwindcss/postcss": "^4.3.0",
    "@types/cookie-parser": "^1.4.10",
    "@types/express": "^5.0.1",
    "@types/node": "^20.17.19",
    "@types/supertest": "^7.2.0",
    "@vitest/coverage-v8": "^4.1.6",
    "angular-eslint": "22.0.0",
    "eslint": "^10.0.3",
    "eslint-config-prettier": "^10.1.8",
    "eslint-plugin-prettier": "^5.5.5",
    "jsdom": "^28.0.0",
    "ng-packagr": "^22.0.0",
    "postcss": "^8.5.3",
    "prettier": "^3.8.1",
    "supertest": "^7.2.2",
    "typescript": "~6.0.3",
    "typescript-eslint": "8.60.1",
    "vitest": "^4.0.8"
  }
}
