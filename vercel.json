{
  "rewrites": [
    {
      "source": "/config",
      "destination": "/api/config"
    },
    {
      "source": "/kitchen/config",
      "destination": "/api/config"
    },
    {
      "source": "/robots.txt",
      "destination": "/api/robots"
    },
    {
      "source": "/:prefix+/sitemap(.*).xml",
      "destination": "/api/sitemap"
    },
    {
      "source": "/sitemap(.*).xml",
      "destination": "/api/sitemap"
    },
    {
      "source": "/kitchen/api/recipes/(.*)",
      "destination": "/api/recipes?slug=$1"
    },
    {
      "source": "/api/recipes/(.*)",
      "destination": "/api/recipes?slug=$1"
    },
    {
      "source": "/kitchen/api/pages/(.*)",
      "destination": "/api/pages?slug=$1"
    },
    {
      "source": "/api/pages/(.*)",
      "destination": "/api/pages?slug=$1"
    },
    {
      "source": "/kitchen/api/:path*",
      "destination": "/api/:path*"
    },
    {
      "source": "/149e9513-01fa-4fb0-aad4-566afd725d1b/2d206a39-8ed7-437e-a3be-862e0f06eea3/a-4-a/c.js",
      "destination": "https://api.vercel.com/bot-protection/v1/challenge"
    },
    {
      "source": "/149e9513-01fa-4fb0-aad4-566afd725d1b/2d206a39-8ed7-437e-a3be-862e0f06eea3/:path*",
      "destination": "https://api.vercel.com/bot-protection/v1/proxy/:path*"
    },
    {
      "source": "/kitchen/(.*\\.[a-zA-Z0-9]+)",
      "destination": "/kitchen/browser/$1"
    },
    {
      "source": "/kitchen/",
      "destination": "/api?path=/kitchen/"
    },
    {
      "source": "/kitchen/:path*",
      "destination": "/api?path=/kitchen/:path*"
    }
  ],
  "functions": {
    "api/index.ts": {
      "includeFiles": "dist/kitchen/**"
    }
  },
  "headers": [
    {
      "source": "/149e9513-01fa-4fb0-aad4-566afd725d1b/2d206a39-8ed7-437e-a3be-862e0f06eea3/:path*",
      "headers": [
        {
          "key": "X-Frame-Options",
          "value": "SAMEORIGIN"
        }
      ]
    },
    {
      "source": "/kitchen/manifest.webmanifest",
      "headers": [
        {
          "key": "Content-Type",
          "value": "application/manifest+json"
        }
      ]
    }
  ]
