              "statements": 95,
              "branches": 95,
              "functions": 95,
              "lines": 95
            }
          }
        },
        "lint": {
          "builder": "@angular-eslint/builder:lint",
          "options": {
            "fix": true,
            "lintFilePatterns": ["projects/serverless/**/*.ts"]
          }
        }
      }
    },
    "@dm/backend-shared": {
      "projectType": "library",
      "root": "projects/dm/backend-shared",
      "sourceRoot": "projects/dm/backend-shared/src",
      "architect": {
        "build": {
          "builder": "@angular/build:application",
          "options": {
            "outputPath": "dist/dm/backend-shared",
            "index": "",
