    },
    "@dm/library": {
      "projectType": "library",
      "root": "projects/dm/library",
      "sourceRoot": "projects/dm/library/src",
      "prefix": "lib",
      "architect": {
        "build": {
          "builder": "@angular/build:ng-packagr",
          "configurations": {
            "production": {
              "tsConfig": "projects/dm/library/tsconfig.lib.prod.json"
            },
            "development": {
              "tsConfig": "projects/dm/library/tsconfig.lib.json"
            }
          },
          "defaultConfiguration": "production"
        },
        "test": {
          "builder": "@angular/build:unit-test",
          "options": {
            "tsConfig": "projects/dm/library/tsconfig.spec.json",
            "coverageReporters": ["lcov"],
            "watch": false,
            "coverageThresholds": {
              "statements": 95,
              "branches": 95,
              "functions": 95,
              "lines": 95
            }
          }
        },
        "lint": {
          "builder": "@angular-eslint/builder:lint",
          "options": {
            "fix": true,
            "lintFilePatterns": ["projects/dm/library/**/*.ts","projects/dm/library/**/*.html"],
            "eslintConfig": "projects/dm/library/eslint.config.js"
          }
        }
      }
    },
    "serverless": {
      "projectType": "library",
      "root": "projects/serverless",
      "sourceRoot": "projects/serverless/src",
      "architect": {
        "test-api": {
          "builder": "@angular/build:unit-test",
          "options": {
            "buildTarget": "delisha-marie:build",
            "coverageReporters": ["lcov"],
            "include": ["projects/serverless/src/api/**/*.test.ts"],
            "watch": false,
            "tsConfig": "projects/serverless/tsconfig.spec.json",
            "runnerConfig": "projects/serverless/src/api/vitest.config.ts",
