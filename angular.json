{
  "$schema": "./node_modules/@angular/cli/lib/config/schema.json",
  "version": 1,
  "cli": {
    "packageManager": "npm",
    "schematicCollections": ["@cypress/schematic", "angular-eslint", "@schematics/angular"]
  },
  "newProjectRoot": "projects",
  "projects": {
    "delisha-marie": {
      "projectType": "application",
      "schematics": {
        "@schematics/angular:component": {
          "inlineTemplate": true,
          "style": "scss"
        }
      },
      "root": "projects/delisha-marie",
      "sourceRoot": "projects/delisha-marie/src",
      "prefix": "dm",
      "architect": {
        "build": {
          "builder": "@angular/build:application",
          "options": {
            "browser": "projects/delisha-marie/src/main.ts",
            "tsConfig": "projects/delisha-marie/tsconfig.app.json",
            "inlineStyleLanguage": "scss",
            "assets": [
              {
                "glob": "**/*",
                "input": "projects/delisha-marie/public"
              }
            ],
            "styles": [
              "projects/delisha-marie/src/tailwind.css",
              "projects/delisha-marie/src/styles.scss"
            ],
            "server": "projects/delisha-marie/src/main.server.ts",
            "outputMode": "server",
            "security": {
              "allowedHosts": []
            },
            "ssr": {
              "entry": "projects/delisha-marie/src/server.ts"
            }
          },
          "configurations": {
            "production": {
              "budgets": [
                {
                  "type": "initial",
                  "maximumWarning": "1mb",
                  "maximumError": "2mb"
                },
                {
                  "type": "anyComponentStyle",
                  "maximumWarning": "4kB",
                  "maximumError": "8kB"
                }
              ],
              "outputHashing": "all"
            },
            "development": {
              "optimization": false,
              "extractLicenses": false,
              "sourceMap": true
            },
            "e2e": {
              "optimization": false,
              "extractLicenses": false,
              "sourceMap": true,
              "ssr": false,
              "prerender": false,
              "outputMode": "static"
            }
          },
          "defaultConfiguration": "production"
        },
        "build-spa": {
          "builder": "@angular/build:application",
          "options": {
            "browser": "projects/delisha-marie/src/main.ts",
            "tsConfig": "projects/delisha-marie/tsconfig.app.json",
            "inlineStyleLanguage": "scss",
            "assets": [
              {
                "glob": "**/*",
                "input": "projects/delisha-marie/public"
              }
            ],
            "styles": [
              "projects/delisha-marie/src/tailwind.css",
              "projects/delisha-marie/src/styles.scss"
            ]
          },
          "configurations": {
            "e2e": {
              "optimization": false,
              "extractLicenses": false,
              "sourceMap": true
            }
          }
        },
        "serve": {
          "builder": "@angular/build:dev-server",
          "configurations": {
            "production": {
              "buildTarget": "delisha-marie:build:production"
            },
            "development": {
              "buildTarget": "delisha-marie:build:development"
            },
            "e2e": {
              "buildTarget": "delisha-marie:build-spa:e2e"
            }
          },
          "defaultConfiguration": "development"
        },
        "test": {
          "builder": "@angular/build:unit-test",
          "options": {
            "coverageReporters": ["lcov"],
            "exclude": ["projects/admin-delisha-marie/src/api/**/*.test.ts"],
            "watch": false
          }
        },
        "lint": {
          "builder": "@angular-eslint/builder:lint",
          "options": {
            "lintFilePatterns": [
              "projects/delisha-marie/**/*.ts",
              "projects/delisha-marie/**/*.html"
            ],
            "eslintConfig": "projects/delisha-marie/eslint.config.js",
            "fix": true
          }
        },
        "cypress-run": {
          "builder": "@cypress/schematic:cypress",
          "options": {
            "devServerTarget": "delisha-marie:serve:e2e",
            "configFile": "projects/delisha-marie/cypress.config.ts"
          },
          "configurations": {
            "production": {
              "devServerTarget": "delisha-marie:serve:production"
            }
          }
        },
        "cypress-open": {
          "builder": "@cypress/schematic:cypress",
          "options": {
            "watch": true,
            "headless": false,
            "configFile": "projects/delisha-marie/cypress.config.ts"
          }
        },
        "ct": {
          "builder": "@cypress/schematic:cypress",
          "options": {
            "devServerTarget": "delisha-marie:serve",
            "watch": true,
            "headless": false,
            "testingType": "component"
          },
          "configurations": {
            "development": {
              "devServerTarget": "delisha-marie:serve:development"
            }
          }
        },
        "e2e": {
          "builder": "@cypress/schematic:cypress",
          "options": {
            "devServerTarget": "delisha-marie:serve:e2e",
            "watch": true,
            "headless": false,
            "configFile": "projects/delisha-marie/cypress.config.ts"
          },
          "configurations": {
            "production": {
              "devServerTarget": "delisha-marie:serve:production"
            }
          }
        }
      }
    },
    "admin-delisha-marie": {
      "projectType": "application",
      "schematics": {
        "@schematics/angular:component": {
          "inlineTemplate": true,
          "style": "scss"
        }
      },
      "root": "projects/admin-delisha-marie",
      "sourceRoot": "projects/admin-delisha-marie/src",
      "prefix": "app",
      "architect": {
        "build": {
          "builder": "@angular/build:application",
          "options": {
            "browser": "projects/admin-delisha-marie/src/main.ts",
            "tsConfig": "projects/admin-delisha-marie/tsconfig.app.json",
            "inlineStyleLanguage": "scss",
            "assets": [
              {
                "glob": "**/*",
                "input": "projects/admin-delisha-marie/public"
              }
            ],
            "styles": [
              "projects/admin-delisha-marie/src/tailwind.css",
              "projects/admin-delisha-marie/src/styles.scss"
            ],
            "server": "projects/admin-delisha-marie/src/main.server.ts",
            "outputMode": "server",
            "ssr": {
              "entry": "projects/admin-delisha-marie/src/server.ts"
            }
          },
          "configurations": {
            "production": {
              "budgets": [
                {
                  "type": "initial",
                  "maximumWarning": "500kB",
                  "maximumError": "1MB"
                },
                {
                  "type": "anyComponentStyle",
                  "maximumWarning": "4kB",
                  "maximumError": "8kB"
                }
              ],
              "outputHashing": "all"
            },
            "development": {
              "optimization": false,
              "extractLicenses": false,
              "sourceMap": true
            },
            "e2e": {
              "optimization": false,
              "extractLicenses": false,
              "sourceMap": true,
              "ssr": false,
              "prerender": false,
              "outputMode": "static"
            }
          },
          "defaultConfiguration": "production"
        },
        "build-spa": {
          "builder": "@angular/build:application",
          "options": {
            "browser": "projects/admin-delisha-marie/src/main.ts",
            "tsConfig": "projects/admin-delisha-marie/tsconfig.app.json",
            "inlineStyleLanguage": "scss",
            "assets": [
              {
                "glob": "**/*",
                "input": "projects/admin-delisha-marie/public"
              }
            ],
            "styles": [
              "projects/admin-delisha-marie/src/tailwind.css",
              "projects/admin-delisha-marie/src/styles.scss"
            ]
          },
          "configurations": {
            "e2e": {
              "optimization": false,
              "extractLicenses": false,
              "sourceMap": true
            }
          }
        },
        "serve": {
          "builder": "@angular/build:dev-server",
          "options": {
            "port": 4201
          },
          "configurations": {
            "production": {
              "buildTarget": "admin-delisha-marie:build:production"
            },
            "development": {
              "buildTarget": "admin-delisha-marie:build:development"
            },
            "e2e": {
              "buildTarget": "admin-delisha-marie:build-spa:e2e"
            }
          },
          "defaultConfiguration": "development"
        },
        "test": {
          "builder": "@angular/build:unit-test",
          "options": {
            "coverageReporters": ["lcov"],
            "exclude": ["projects/admin-delisha-marie/src/api/**/*.test.ts"],
            "watch": false
          }
        },
        "test-api": {
          "builder": "@angular/build:unit-test",
          "options": {
            "coverageReporters": ["lcov"],
            "include": ["projects/admin-delisha-marie/src/api/**/*.test.ts"],
            "watch": false,
            "runnerConfig": "projects/admin-delisha-marie/src/api/vitest.config.ts"
          }
        },
        "lint": {
          "builder": "@angular-eslint/builder:lint",
          "options": {
            "lintFilePatterns": [
              "projects/admin-delisha-marie/**/*.ts",
              "projects/admin-delisha-marie/**/*.html"
            ],
            "eslintConfig": "projects/admin-delisha-marie/eslint.config.js",
            "fix": true
          }
        },
        "cypress-run": {
          "builder": "@cypress/schematic:cypress",
          "options": {
            "devServerTarget": "admin-delisha-marie:serve:e2e",
            "configFile": "projects/admin-delisha-marie/cypress.config.ts"
          },
          "configurations": {
            "production": {
              "devServerTarget": "admin-delisha-marie:serve:production"
            }
          }
        },
        "cypress-open": {
          "builder": "@cypress/schematic:cypress",
          "options": {
            "watch": true,
            "headless": false,
            "configFile": "projects/admin-delisha-marie/cypress.config.ts"
          }
        },
        "ct": {
          "builder": "@cypress/schematic:cypress",
          "options": {
            "devServerTarget": "admin-delisha-marie:serve",
            "watch": true,
            "headless": false,
            "testingType": "component"
          },
          "configurations": {
            "development": {
              "devServerTarget": "admin-delisha-marie:serve:development"
            }
          }
        },
        "e2e": {
          "builder": "@cypress/schematic:cypress",
          "options": {
            "devServerTarget": "admin-delisha-marie:serve:e2e",
            "watch": true,
            "headless": false,
            "configFile": "projects/admin-delisha-marie/cypress.config.ts"
          },
          "configurations": {
            "production": {
              "devServerTarget": "admin-delisha-marie:serve:production"
            }
          }
        }
      }
    },
    "@dm/library": {
      "projectType": "library",
      "root": "projects/dm/library",
      "sourceRoot": "projects/dm/library/src",
      "prefix": "lib",
      "architect": {
        "build": {
          "builder": "@angular/build:ng-packagr",
          "configurations": {
            "production": {
              "tsConfig": "projects/dm/library/tsconfig.lib.prod.json"
            },
            "development": {
              "tsConfig": "projects/dm/library/tsconfig.lib.json"
            }
          },
          "defaultConfiguration": "production"
        },
        "test": {
          "builder": "@angular/build:unit-test",
          "options": {
            "tsConfig": "projects/dm/library/tsconfig.spec.json",
            "coverageReporters": ["lcov"],
            "watch": false
          }
        },
        "lint": {
          "builder": "@angular-eslint/builder:lint",
          "options": {
            "fix": true,
            "lintFilePatterns": ["projects/dm/library/**/*.ts", "projects/dm/library/**/*.html"],
            "eslintConfig": "projects/dm/library/eslint.config.js"
          }
        }
      }
    }
  }
}
