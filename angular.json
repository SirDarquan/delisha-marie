{
  "$schema": "./node_modules/@angular/cli/lib/config/schema.json",
  "version": 1,
  "cli": {
    "packageManager": "npm",
    "schematicCollections": [
      "@cypress/schematic",
      "angular-eslint",
      "@schematics/angular"
    ],
    "analytics": false,
    "cache": {
      "enabled": true,
      "environment": "all"
    }
  },
  "newProjectRoot": "projects",
  "projects": {
    "kitchen": {
      "projectType": "application",
      "schematics": {
        "@schematics/angular:component": {
          "inlineTemplate": true,
          "style": "scss"
        }
      },
      "root": "projects/kitchen",
      "sourceRoot": "projects/kitchen/src",
      "prefix": "dm",
      "architect": {
        "build": {
          "builder": "@angular/build:application",
          "options": {
            "browser": "projects/kitchen/src/main.ts",
            "tsConfig": "projects/kitchen/tsconfig.app.json",
            "inlineStyleLanguage": "scss",
            "assets": [
              {
                "glob": "**/*",
                "input": "projects/kitchen/public"
              }
            ],
            "styles": [
              "projects/kitchen/src/tailwind.css",
              "projects/kitchen/src/styles.scss"
            ],
            "server": "projects/kitchen/src/main.server.ts",
            "outputMode": "server",
            "security": {
              "allowedHosts": [
                "localhost",
                "127.0.0.1",
                "[::1]",
                "*.vercel.app"
              ]
            },
            "ssr": {
              "entry": "projects/kitchen/src/server.ts"
            }
          },
          "configurations": {
            "production": {
              "outputPath": {
                "base": "dist/kitchen",
                "browser": "browser",
                "server": "server"
              },
              "deployUrl": "/kitchen/",
              "baseHref": "/kitchen/",
              "budgets": [
                {
                  "type": "initial",
                  "maximumWarning": "2mb",
                  "maximumError": "4mb"
                },
                {
                  "type": "anyComponentStyle",
                  "maximumWarning": "4kB",
                  "maximumError": "8kB"
                }
              ],
              "outputHashing": "all",
              "serviceWorker": "projects/kitchen/ngsw-config.json"
            },
            "development": {
              "optimization": false,
              "extractLicenses": false,
              "sourceMap": {
                "scripts": true,
                "styles": false,
                "vendor": false
              }
            },
            "e2e": {
              "optimization": false,
              "extractLicenses": false,
              "sourceMap": true,
              "ssr": false,
              "prerender": false,
              "outputMode": "static"
            }
          },
          "defaultConfiguration": "production"
        },
        "build-spa": {
          "builder": "@angular/build:application",
          "options": {
            "browser": "projects/kitchen/src/main.ts",
            "tsConfig": "projects/kitchen/tsconfig.app.json",
            "inlineStyleLanguage": "scss",
            "assets": [
              {
                "glob": "**/*",
                "input": "projects/kitchen/public"
              }
            ],
            "styles": [
              "projects/kitchen/src/tailwind.css",
              "projects/kitchen/src/styles.scss"
            ]
          },
          "configurations": {
            "e2e": {
              "optimization": false,
              "extractLicenses": false,
              "sourceMap": true
            }
          }
        },
        "serve": {
          "builder": "@angular/build:dev-server",
          "options": {
            "host": "0.0.0.0",
            "allowedHosts": true,
            "port": 4201
          },
          "configurations": {
            "production": {
              "buildTarget": "kitchen:build:production"
            },
            "development": {
              "buildTarget": "kitchen:build:development"
            },
            "e2e": {
              "buildTarget": "kitchen:build-spa:e2e",
              "port": 4211
            }
          },
          "defaultConfiguration": "development"
        },
        "test": {
          "builder": "@angular/build:unit-test",
          "options": {
            "coverageReporters": [
              "lcov"
            ],
            "exclude": [
              "../../projects/serverless/src/api/**/*.test.ts"
            ],
            "watch": false,
            "coverageThresholds": {
              "statements": 94,
              "branches": 90,
              "functions": 94,
              "lines": 94
            },
            "coverageExclude": [
              "projects/dm/library/**/*"
            ],
            "setupFiles": [
              "test/vitest.setup.ts"
            ]
          }
        },
        "lint": {
          "builder": "@angular-eslint/builder:lint",
          "options": {
            "lintFilePatterns": [
              "projects/kitchen/**/*.ts",
              "projects/kitchen/**/*.html"
            ],
            "eslintConfig": "projects/kitchen/eslint.config.js",
            "fix": true
          }
        },
        "cypress-run": {
          "builder": "@cypress/schematic:cypress",
          "options": {
            "devServerTarget": "kitchen:serve:e2e",
            "configFile": "projects/kitchen/cypress.config.ts"
          },
          "configurations": {
            "production": {
              "devServerTarget": "kitchen:serve:production"
            }
          }
        },
        "cypress-open": {
          "builder": "@cypress/schematic:cypress",
          "options": {
            "watch": true,
            "headless": false,
            "configFile": "projects/kitchen/cypress.config.ts"
          }
        },
        "ct": {
          "builder": "@cypress/schematic:cypress",
          "options": {
            "devServerTarget": "kitchen:serve",
            "watch": true,
            "headless": false,
            "testingType": "component"
          },
          "configurations": {
            "development": {
              "devServerTarget": "kitchen:serve:development"
            }
          }
        },
        "e2e": {
          "builder": "@cypress/schematic:cypress",
          "options": {
            "devServerTarget": "kitchen:serve:e2e",
            "watch": true,
            "headless": false,
            "configFile": "projects/kitchen/cypress.config.ts"
          },
          "configurations": {
            "production": {
              "devServerTarget": "kitchen:serve:production"
            }
          }
        }
      }
    },
