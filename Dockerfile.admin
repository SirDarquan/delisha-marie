# Build Stage
FROM node:24-slim AS build

WORKDIR /app

# Copy package files
COPY package.json package-lock.json ./

# Install all dependencies including devDependencies for the build
RUN npm ci

# Copy source code
COPY . .

# Build the admin dashboard application explicitly
RUN SUPABASE_URL="https://placeholder.supabase.co" SUPABASE_KEY="placeholder" npx ng build admin-delisha-marie


# Run Stage
FROM node:24-slim AS run

WORKDIR /app

# Copy built application and package files from build stage
COPY --from=build /app/dist /app/dist
COPY --from=build /app/package.json /app/package.json
COPY --from=build /app/package-lock.json /app/package-lock.json

# Install only production dependencies
RUN npm ci --only=production

# Set environment variables
ENV NODE_ENV=production
ENV PORT=8080

# Expose the port
EXPOSE 8080

# Start the server targeting the admin application
CMD ["npm", "run", "serve:ssr:admin-delisha-marie"]
